#!/bin/bash

DISPLAYS=$(yabai -m query --displays)
NUM_DISPLAYS=$(echo "$DISPLAYS" | jq length)
CURRENT_DISPLAY=$(echo "$DISPLAYS" | jq -r '.[] | select(.["has-focus"] == true) | .uuid')
CURRENT_DISPLAY_INDEX=$(echo "$DISPLAYS" | jq -r --arg uuid "$CURRENT_DISPLAY" '.[] | select(.uuid == $uuid) | .index')
CURRENT_DISPLAY_FRAME=$(echo "$DISPLAYS" | jq -c --arg uuid "$CURRENT_DISPLAY" '.[] | select(.uuid == $uuid) | .frame')
UUID_INBUILT_DISPLAY="37D8832A-2D66-02CA-B9F7-8F30A301B230"
CURRENT_APP=$(yabai -m query --windows --window | jq -r '.app')
CURRENT_APP_ALT=$(sketchybar --query front_app | jq -r '.icon.value')

# Only let cliclick_focus run if the window it would center on is still on
# the display we started this script on — see summary at bottom for why.
safe_cliclick_focus() {
    local focused_window_display
    focused_window_display=$(yabai -m query --windows --window 2>/dev/null | jq -r '.display // empty')
    if [[ -n "$focused_window_display" && "$focused_window_display" == "$CURRENT_DISPLAY_INDEX" ]]; then
        ~/bin/cliclick_focus
    fi
}

case "$CURRENT_APP_ALT" in
    "Finder") 
        skhd -k "cmd - w"
        ;;
    "LogiTune") 
        sketchybar --set logi icon.color=0xff4e4e4e
        osascript -e 'tell application "Logi Tune" to quit'
        sketchybar --update
        CURRENT_DISPLAY="$UUID_INBUILT_DISPLAY"
        CURRENT_DISPLAY_INDEX=$(echo "$DISPLAYS" | jq -r --arg uuid "$UUID_INBUILT_DISPLAY" '.[] | select(.uuid == $uuid) | .index')
        CURRENT_DISPLAY_FRAME=$(echo "$DISPLAYS" | jq -c --arg uuid "$UUID_INBUILT_DISPLAY" '.[] | select(.uuid == $uuid) | .frame')
        ;;
    "Threema Beta") 
        killall ThreemaDesktop &> /dev/null
        ;;
    "Thunderbird") 
        killall thunderbird &> /dev/null
        sleep 0.1
        ~/.config/sketchybar/plugins/badge.sh
        ;;
    "OBS Studio") 
        osascript -e 'tell application "OBS" to quit'
        ;;
    "TotalMix FX") 
        osascript -e 'tell application "TotalMix FX" to quit'
        yabai -m window --focus mouse
        exit
        ;;
    "zoom.us") 
        killall zoom.us &> /dev/null
        ;;
    # "LibreOffice") osascript -e 'tell application "LibreOffice" to quit' ;;
    "calibre")
        killall calibre &> /dev/null
        ;;
    "Elgato Control Center")
        sketchybar --set elgato icon.color=0xff4e4e4e
        killall "Elgato Control Center" &> /dev/null
        # osascript -e 'tell application "Elgato Control Center" to quit'
        ;;
    "Mouseless")
        killall mouseless &> /dev/null
        sleep 2 # 1.37
        open_or_focus "Mouseless"
        ;;
    "AltTab")
        killall AltTab &> /dev/null
        sleep 1
        open_or_focus "AltTab"
        ;;    
    *) 
        if [[ "$CURRENT_APP" == *WhatsApp* ]]; then
            killall WhatsApp &> /dev/null
        elif [[ "$CURRENT_APP" == "DaVinci Resolve" ]]; then
            killall Resolve
        else
            skhd -k "cmd - q"
        fi
        ;;
esac
# sleep 0.37 # 0.73
sleep 0.37 # sleep 0.73 #0.37 # 1 # 2.1 # # # 

if [[ -n "$CURRENT_DISPLAY_FRAME" && "$CURRENT_DISPLAY_FRAME" != "null" ]]; then
    read -r TARGET_X TARGET_Y <<< "$(echo "$CURRENT_DISPLAY_FRAME" | jq -r '"\(.x + .w/2 | floor) \(.y + .h/2 | floor)"')"
    cliclick m:${TARGET_X},${TARGET_Y}
elif [[ $NUM_DISPLAYS -eq 1 ]]; then
    cliclick m:900,603
elif [[ $CURRENT_DISPLAY == "$UUID_INBUILT_DISPLAY" ]]; then
    cliclick m:3460,603
else
    cliclick m:1280,720
fi

# ~/bin/cliclick_focus # # # 
# sleep 0.1
sleep 0.37 # sleep 1 # # # 
[[ $(yabai -m query --spaces --display "$(display_query_cliclick)" | jq '.[] | select(."is-visible" == true) | ."windows" | length') == 0 ]] && cliclick c:. && osascript -e 'tell application "System Events" to set visible of every process whose visible is false to true'
# sleep 0.1
sleep 0.37
safe_cliclick_focus

/opt/homebrew/bin/yabai -m window --focus mouse >/dev/null 2>&1 || true

# sleep 0.1
sketchybar --update
# instead of change_display_... needed: when closing last app in space!

# =============================================================================
# CHANGE LOG — cursor-jumps-to-wrong-display bug, worked through with Claude
# =============================================================================
#
# SYMPTOM: after quitting an app via this script, the cursor sometimes ended
# up centered on the WRONG display — e.g. focused on Notes (inbuilt display)
# and its underlying window instead of Firefox (external display), even
# though the app being quit and the "next" window were both on the external
# display the whole time.
#
# THEORIES TRIED AND RULED OUT (kept here so we don't re-litigate them):
#   1. Hardcoded cliclick pixel coords (900,603 / 3460,603 / 1280,720) only
#      valid for one specific monitor arrangement — real issue, but fixing it
#      alone (see FIX 1 below) did not resolve the reported symptom.
#   2. "has-focus" not existing on yabai display objects — WRONG, disproved
#      by direct testing: `yabai -m query --displays | jq -r '.[] |
#      select(.["has-focus"]==true) | .uuid'` correctly returns the focused
#      display's uuid.
#   3. Coordinate-space mismatch (Cocoa bottom-left-origin vs Quartz
#      top-left-origin) between yabai's frame data and cliclick — WRONG,
#      disproved: both displays reported y:0 and cliclick's own reported
#      pointer position matched expectations exactly.
#   4. A yabai signal (`yabai -m signal --list`) reacting to window/app focus
#      and warping the mouse — WRONG, disproved: none of the registered
#      signals touch the mouse at all (all sketchybar/mission-control/dock
#      related).
#
# ACTUAL ROOT CAUSE (confirmed):
#   ~/bin/cliclick_focus queries `yabai -m query --windows --window` with NO
#   target, which returns the SYSTEM-WIDE focused window, not one scoped to
#   any particular display. When the quit-app was the frontmost app, macOS's
#   own app-activation history reactivates whatever was PREVIOUSLY frontmost,
#   system-wide — e.g. Notes on the inbuilt display — regardless of what's
#   sitting on the display you were actually using (e.g. Firefox). This
#   script calls `~/bin/cliclick_focus` at the very end, AFTER its own
#   deliberate display-centering `cliclick`, so it silently overwrote that
#   centering with wherever the globally-reactivated window happened to be.
#   This explains the intermittency: it only failed when app-reactivation
#   jumped to a window on a DIFFERENT display than the one in use.
#
# FIXES APPLIED:
#   FIX 1 — Dynamic frame-center cursor placement. Replaced the hardcoded
#     cliclick coordinates with a calculation based on the actual focused
#     display's frame (CURRENT_DISPLAY_FRAME, x + w/2, y + h/2), kept the
#     original hardcoded values as final fallbacks only. Not the actual bug,
#     but more robust against future monitor/resolution/arrangement changes,
#     so kept intentionally.
#   FIX 2 — LogiTune branch: kept CURRENT_DISPLAY_INDEX/CURRENT_DISPLAY_FRAME
#     in sync with that branch's existing CURRENT_DISPLAY override, since the
#     rest of the script now reads the frame/index instead of re-deriving it.
#   FIX 3 (the actual fix) — safe_cliclick_focus() wrapper: only invokes
#     ~/bin/cliclick_focus if the currently-focused window (per yabai) is
#     still on CURRENT_DISPLAY_INDEX, the display this script started on.
#     Left ~/bin/cliclick_focus itself untouched, since it's presumably used
#     elsewhere too and changing its core behavior could break other callers.
#
# OPEN ITEMS / NOT YET VERIFIED:
#   - Assumes yabai window objects' `.display` field is a bare index matching
#     display objects' `.index` field (not a uuid) — worked in testing so
#     far, but worth re-confirming if this stops working after a yabai
#     update: `yabai -m query --windows --window | jq '.display'`
#   - The first `~/bin/cliclick_focus` call earlier in the original script
#     was already commented out (`# ~/bin/cliclick_focus # # #`) before this
#     thread started — left as-is/inert; only the second, live call was
#     swapped for safe_cliclick_focus.
# =============================================================================